~~ Builds a macOS .icns icon out of the PNGs that make_icons.spf drew.
~~
~~ An .icns file is simple: the magic "icns", the total length as a
~~ big endian 32 bit number, then one record per image — a four letter
~~ type, the record length, and the PNG bytes themselves. Writing it
~~ here means the Mac build needs no `iconutil`, and it is one more
~~ format SPRFST can produce on its own.
~~
~~     sprfst run assets/logo/make_icns.spf [out.icns]
use std.io
use std.fs
use std.math
use std.sys
use std.path

~~ A 32 bit number, most significant byte first.
fn be32(n: Int) -> [Int] {
    give [math.floor(n / 16777216) % 256,
          math.floor(n / 65536) % 256,
          math.floor(n / 256) % 256,
          n % 256]
}

~~ One icns record: type, length including this header, then the image.
fn record(kind: Text, png: [Int]) -> [Int] {
    var out: [Int] = []
    for b in kind.bytes() { out.push(b) }
    for b in be32(png.len() + 8) { out.push(b) }
    for b in png { out.push(b) }
    give out
}

fn main() {
    let args = sys.args()
    let out = args.first() ?? "dist/SPRFST.icns"

    ~~ Which PNG goes in under which type code. The @2x entries are the
    ~~ same picture at twice the size, which is exactly what Retina wants.
    let kinds = ["icp4", "icp5", "ic11", "ic12", "ic07", "ic13", "ic08", "ic14", "ic09"]
    let sizes = [16, 32, 32, 64, 128, 256, 256, 512, 512]

    var body: [Int] = []
    var used = 0
    for i in 0..kinds.len() {
        let file = "assets/logo/png/sprfst-{sizes[i]}.png"
        if not fs.exists(file) {
            io.warn("missing {file} — run  sprfst run assets/logo/make_icons.spf  first")
            sys.exit(1)
        }
        let png = fs.read_bytes(file) ?? []
        for b in record(kinds[i], png) { body.push(b) }
        used = used + 1
    }

    var icns: [Int] = []
    for b in "icns".bytes() { icns.push(b) }
    for b in be32(body.len() + 8) { icns.push(b) }
    for b in body { icns.push(b) }

    let folder = path.dirname(out)
    if folder != "" and not fs.exists(folder) { fs.mkdir(folder) }

    if fs.write_bytes(out, icns) {
        io.say("wrote {out} — {used} images, {math.floor(icns.len() / 1024)} KB")
    } else {
        io.warn("could not write {out}")
        sys.exit(1)
    }
}
