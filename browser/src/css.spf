~~ =====================================================================
~~  SPRFST Browser — style
~~
~~  A cascade over the part of CSS that changes how a document reads:
~~  colour, type, spacing, alignment and whether a thing is shown at
~~  all. Selectors go as far as tag, class, id and descendant, which is
~~  what the overwhelming majority of real rules are made of.
~~ =====================================================================
module css

~~ The computed look of one element.
pub object Style {
    display: Text = "inline"       ~~ inline, block, list-item or none
    colour: Int = -1               ~~ -1 means "take it from the parent"
    background: Int = -1
    size: Num = 16.0
    weight: Int = 400
    italic: Bool = false
    underline: Bool = false
    mono: Bool = false
    pre: Bool = false
    align: Text = "left"
    margin_top: Num = 0.0
    margin_bottom: Num = 0.0
    indent: Num = 0.0
    bullet: Text = ""
    bar: Int = -1                  ~~ a rule down the left, for quotes
    hidden: Bool = false
    level: Int = 0                 ~~ heading level

    fn inherit(self) -> Style {
        give Style {
            colour: self.colour, size: self.size, weight: self.weight,
            italic: self.italic, mono: self.mono, pre: self.pre,
            align: self.align, underline: false, display: "inline"
        }
    }
}

pub object Rule {
    parts: [Text] = []             ~~ compound selectors, outermost first
    weight: Int = 0
    order: Int = 0
    decls: Map<Text, Text> = [:]
}

pub object Sheet {
    rules: [Rule] = []

    fn add(self, rule: Rule) { self.rules.push(rule) }

    fn count(self) -> Int => self.rules.len()
}

~~ ------------------------------------------------------------ colours
pub fn rgb(r: Int, g: Int, b: Int) -> Int => r * 65536 + g * 256 + b

pub fn colour_of(raw: Text) -> Int {
    let text = raw.trim().lower()
    if text == "" { give -1 }
    if text.starts_with("#") {
        let digits = text.slice(1, text.len())
        if digits.len() == 3 {
            let r = hex_digit(digits.char_at(0))
            let g = hex_digit(digits.char_at(1))
            let b = hex_digit(digits.char_at(2))
            give rgb(r * 17, g * 17, b * 17)
        }
        if digits.len() >= 6 {
            give rgb(hex_pair(digits, 0), hex_pair(digits, 2), hex_pair(digits, 4))
        }
        give -1
    }
    if text.starts_with("rgb") {
        let open = text.index_of("(")
        let close = text.index_of(")")
        if open < 0 or close < open { give -1 }
        let inside = text.slice(open + 1, close)
        let bits = if inside.contains(",") { inside.split(",") } else { inside.split(" ") }
        if bits.len() < 3 { give -1 }
        give rgb(number(bits[0]), number(bits[1]), number(bits[2]))
    }
    give named(text)
}

fn number(raw: Text) -> Int {
    let value = raw.trim().replace("%", "").to_num() ?? 0.0
    give to_int(value)
}

fn hex_digit(ch: Text) -> Int {
    let c = ch.lower().code_at(0)
    if c >= 48 and c <= 57 { give c - 48 }
    if c >= 97 and c <= 102 { give c - 87 }
    give 0
}

fn hex_pair(text: Text, at: Int) -> Int {
    give hex_digit(text.char_at(at)) * 16 + hex_digit(text.char_at(at + 1))
}

fn named(name: Text) -> Int {
    if name == "black" { give 0 }
    if name == "white" { give rgb(255, 255, 255) }
    if name == "red" { give rgb(220, 60, 60) }
    if name == "green" { give rgb(40, 160, 70) }
    if name == "blue" { give rgb(60, 110, 220) }
    if name == "navy" { give rgb(20, 40, 110) }
    if name == "grey" or name == "gray" { give rgb(128, 128, 128) }
    if name == "silver" { give rgb(192, 192, 192) }
    if name == "orange" { give rgb(240, 150, 40) }
    if name == "yellow" { give rgb(240, 220, 70) }
    if name == "purple" { give rgb(130, 70, 180) }
    if name == "teal" { give rgb(40, 150, 150) }
    if name == "maroon" { give rgb(130, 40, 40) }
    if name == "olive" { give rgb(130, 130, 40) }
    if name == "lime" { give rgb(100, 220, 100) }
    if name == "aqua" or name == "cyan" { give rgb(80, 210, 220) }
    if name == "pink" { give rgb(240, 160, 200) }
    if name == "brown" { give rgb(140, 100, 60) }
    if name == "transparent" { give -1 }
    give -1
}

~~ ------------------------------------------------------------ lengths
pub fn length(raw: Text, parent_size: Num) -> Num {
    var text = raw.trim().lower()
    if text == "" { give 0.0 }
    if text == "0" { give 0.0 }
    if text.ends_with("px") { give text.slice(0, text.len() - 2).to_num() ?? 0.0 }
    if text.ends_with("pt") { give (text.slice(0, text.len() - 2).to_num() ?? 0.0) * 4.0 / 3.0 }
    if text.ends_with("rem") { give (text.slice(0, text.len() - 3).to_num() ?? 0.0) * 16.0 }
    if text.ends_with("em") { give (text.slice(0, text.len() - 2).to_num() ?? 0.0) * parent_size }
    if text.ends_with("%") { give (text.slice(0, text.len() - 1).to_num() ?? 0.0) / 100.0 * parent_size }
    give text.to_num() ?? 0.0
}

~~ Where a part appears at or after an offset. Text.index_of always
~~ starts at the beginning, and slicing the rest of a stylesheet on
~~ every step would make parsing quadratic.
pub fn index_of_from(text: Text, part: Text, from: Int) -> Int {
    let first = part.code_at(0)
    let width = part.len()
    let n = text.len()
    var i = if from < 0 { 0 } else { from }
    while i + width <= n {
        if text.code_at(i) == first {
            if text.slice(i, i + width) == part { give i }
        }
        i = i + 1
    }
    give -1
}

~~ ------------------------------------------------------------- parsing
~~ Read a stylesheet. At-rules are skipped whole, except @media, whose
~~ body is read as though the query had matched.
pub fn parse(source: Text) -> Sheet {
    var sheet = Sheet { }
    var order = 0
    let text = strip_comments(source)
    let n = text.len()
    var i = 0
    while i < n {
        let brace = index_of_from(text, "{{", i)
        if brace < 0 { break }
        var selector = text.slice(i, brace).trim()

        if selector.starts_with("@") {
            let head = selector.lower()
            if head.starts_with("@media") or head.starts_with("@supports") {
                ~~ step inside and keep reading rules
                i = brace + 1
                skip
            }
            let close = matching_brace(text, brace, n)
            i = close + 1
            skip
        }
        if selector.starts_with("}}") { selector = selector.slice(1, selector.len()).trim() }

        let close = index_of_from(text, "}}", brace)
        if close < 0 { break }
        let body = text.slice(brace + 1, close)
        if selector != "" {
            for one in selector.split(",") {
                let rule = make_rule(one.trim(), body, order)
                if rule != nil { sheet.add(rule ?? Rule { }) }
                order = order + 1
            }
        }
        i = close + 1
    }
    give sheet
}

fn strip_comments(source: Text) -> Text {
    if not source.contains("/*") { give source }
    var out: [Text] = []
    var i = 0
    let n = source.len()
    while i < n {
        let start = index_of_from(source, "/*", i)
        if start < 0 {
            out.push(source.slice(i, n))
            break
        }
        out.push(source.slice(i, start))
        let close = index_of_from(source, "*/", start + 2)
        if close < 0 { break }
        i = close + 2
    }
    give out.join("")
}

fn matching_brace(text: Text, open: Int, upto: Int) -> Int {
    var depth = 0
    var i = open
    while i < upto {
        let c = text.code_at(i)
        if c == 123 { depth = depth + 1 }
        if c == 125 {
            depth = depth - 1
            if depth <= 0 { give i }
        }
        i = i + 1
    }
    give upto
}

fn make_rule(selector: Text, body: Text, order: Int) -> Rule? {
    if selector == "" { give nil }
    if selector.contains("[") or selector.contains("::") { give nil }
    var rule = Rule { order: order }
    for word in selector.split(" ") {
        var part = word.trim().lower()
        if part == "" or part == ">" or part == "+" or part == "~" { skip }
        if part.starts_with(">") { part = part.slice(1, part.len()) }
        let colon = part.index_of(":")
        if colon >= 0 { part = part.slice(0, colon) }
        if part == "" or part == "*" { skip }
        rule.parts.push(part)
        rule.weight = rule.weight + weight_of(part)
    }
    if rule.parts.len() == 0 { give nil }
    for piece in body.split(";") {
        let colon = piece.index_of(":")
        if colon < 0 { skip }
        let name = piece.slice(0, colon).trim().lower()
        var value = piece.slice(colon + 1, piece.len()).trim()
        if value.ends_with("!important") {
            value = value.slice(0, value.len() - 10).trim()
            rule.weight = rule.weight + 1000
        }
        if name != "" and value != "" { rule.decls.set(name, value) }
    }
    if rule.decls.len() == 0 { give nil }
    give rule
}

fn weight_of(part: Text) -> Int {
    var score = 0
    if part.starts_with("#") { score = 100 }
    else if part.starts_with(".") { score = 10 }
    else { score = 1 }
    var extra = 0
    for ch in part.chars() {
        if ch == "." { extra = extra + 10 }
        if ch == "#" { extra = extra + 100 }
    }
    if extra > 0 { give extra }
    give score
}

~~ ------------------------------------------------------------ matching
~~ One step of a selector against one element.
pub fn part_matches(part: Text, tag: Text, id: Text, classes: [Text]) -> Bool {
    var rest = part
    if rest.starts_with("*") { rest = rest.slice(1, rest.len()) }
    if rest == "" { give true }
    var want_tag = ""
    while rest != "" {
        let c = rest.char_at(0)
        if c == "." {
            let stop = next_marker(rest, 1)
            let name = rest.slice(1, stop)
            if not classes.contains(name) { give false }
            rest = rest.slice(stop, rest.len())
            skip
        }
        if c == "#" {
            let stop = next_marker(rest, 1)
            if rest.slice(1, stop) != id { give false }
            rest = rest.slice(stop, rest.len())
            skip
        }
        let stop = next_marker(rest, 0)
        want_tag = rest.slice(0, stop)
        rest = rest.slice(stop, rest.len())
        if want_tag != "" and want_tag != tag { give false }
    }
    give true
}

fn next_marker(text: Text, from: Int) -> Int {
    var i = from
    while i < text.len() {
        let c = text.char_at(i)
        if c == "." or c == "#" { give i }
        i = i + 1
    }
    give text.len()
}
