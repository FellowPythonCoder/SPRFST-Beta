~~ =====================================================================
~~  SPRFST Browser — search results
~~
~~  DuckDuckGo gives us a plain HTML result page. This module turns that
~~  page into a small, readable search page of our own: an overview from
~~  the best result followed by direct links. No JavaScript and no remote
~~  search UI are needed, so it stays fast and keeps the page engine in
~~  SPRFST.
~~ =====================================================================
module search

use html
use std.http

pub object Hit {
    title: Text = ""
    url: Text = ""
    snippet: Text = ""
}

fn has_class(node: html.Node, wanted: Text) -> Bool {
    give node.classes().contains(wanted)
}

fn gather(node: html.Node, wanted: Text, into: [html.Node]) {
    if node.kind == "element" and has_class(node, wanted) { into.push(node) }
    for kid in node.kids { gather(kid, wanted, into) }
}

fn direct_url(raw: Text) -> Text {
    var url = raw.trim()
    if url.starts_with("//") { url = "https:" + url }
    ~~ DuckDuckGo's HTML endpoint often wraps a result in
    ~~ /l/?uddg=https%3A%2F%2F... . Keep the real destination.
    let encoded = url.index_of("uddg=")
    if encoded >= 0 {
        url = url.slice(encoded + 5, url.len())
        let amp = url.index_of("&")
        if amp >= 0 { url = url.slice(0, amp) }
        url = http.url_decode(url)
    }
    if url.starts_with("/") { give "https://duckduckgo.com" + url }
    give url
}

fn escape(text: Text) -> Text {
    give text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

fn attribute(text: Text) -> Text {
    give escape(text).replace("\"", "&quot;")
}

fn collect(raw: Text) -> [Hit] {
    let document = html.parse(raw)
    var title_nodes: [html.Node] = []
    var snippet_nodes: [html.Node] = []
    gather(document, "result__a", title_nodes)
    gather(document, "result__snippet", snippet_nodes)

    var out: [Hit] = []
    var i = 0
    while i < title_nodes.len() and out.len() < 8 {
        let node = title_nodes[i]
        let url = direct_url(node.attr("href"))
        if (url.starts_with("http://") or url.starts_with("https://")) and node.inner_text().trim() != "" {
            var snippet = ""
            if i < snippet_nodes.len() { snippet = snippet_nodes[i].inner_text().trim() }
            out.push(Hit {
                title: html.squash(node.inner_text()).trim(),
                url: url,
                snippet: html.squash(snippet)
            })
        }
        i = i + 1
    }
    give out
}

pub fn render(raw: Text, query: Text) -> Text {
    let hits = collect(raw)
    if hits.len() == 0 { give raw }

    var out = "<html><head><title>" + escape(query) + " - Search</title>"
    out = out + "<style>"
    out = out + "body{{background:#202124;color:#e8eaed;font-family:Helvetica;margin:0 auto;max-width:900px}}"
    out = out + "h1{{color:#8ab4f8;font-size:28px;margin-bottom:4px}}"
    out = out + "h2{{color:#e8eaed;font-size:20px;margin-top:28px}}"
    out = out + ".overview{{background:#303134;border-radius:10px;padding:16px;margin:18px 0}}"
    out = out + ".result{{margin:18px 0}}.result h3{{color:#8ab4f8;font-size:18px;margin:3px 0}}"
    out = out + ".url{{color:#bdc1c6;font-size:12px}}.snippet{{color:#bdc1c6;margin-top:5px}}"
    out = out + "</style></head><body>"
    out = out + "<p class=\"url\">Search</p><h1>" + escape(query) + "</h1>"

    let first = hits[0]
    if first.snippet != "" {
        out = out + "<section class=\"overview\"><h2>Overview</h2><p>" +
              escape(first.snippet) + "</p><p class=\"url\">From " +
              escape(first.title) + "</p></section>"
    }

    out = out + "<h2>Search results</h2><ol>"
    for hit in hits {
        out = out + "<li class=\"result\"><a href=\"" + attribute(hit.url) + "\"><h3>" +
              escape(hit.title) + "</h3></a><p class=\"url\">" +
              escape(hit.url) + "</p>"
        if hit.snippet != "" { out = out + "<p class=\"snippet\">" + escape(hit.snippet) + "</p>" }
        out = out + "</li>"
    }
    out = out + "</ol></body></html>"
    give out
}
